<Window x:Class="LLM_Memory_Manager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ayarlar" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Model ve Bellek Ayarları"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#252526" CornerRadius="10" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Model Adı" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,12,12"/>
                <TextBox x:Name="ModelNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Padding="10" Background="#333337" Foreground="White" BorderThickness="0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Context Length" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,12,12"/>
                <TextBox x:Name="ContextLengthTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Padding="10" Background="#333337" Foreground="White" BorderThickness="0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Memory Messages" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,12,12"/>
                <TextBox x:Name="MaxMemoryMessagesTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Padding="10" Background="#333337" Foreground="White" BorderThickness="0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU Threads" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,12,12"/>
                <TextBox x:Name="CpuThreadsTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Padding="10" Background="#333337" Foreground="White" BorderThickness="0"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="GPU Layers" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,12,12"/>
                <TextBox x:Name="GpuLayersTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" Padding="10" Background="#333337" Foreground="White" BorderThickness="0"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Temperature" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="TemperatureTextBox" Grid.Row="5" Grid.Column="1" Padding="10" Background="#333337" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Vazgeç"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="BtnVazgec_Click"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="Kaydet"
                    Width="100"
                    Click="BtnKaydet_Click"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
