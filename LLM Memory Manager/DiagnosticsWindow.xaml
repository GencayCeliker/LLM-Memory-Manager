<Window x:Class="LLM_Memory_Manager.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tanılama ve Ölçüm" Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="VRAM / Bellek / Bağlantı Tanılama"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Background="#252526" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="İşlem Belleği" Foreground="#C8C8C8" FontSize="13"/>
                    <TextBlock x:Name="ProcessMemoryTextBlock" Text="-" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#252526" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Working Set" Foreground="#C8C8C8" FontSize="13"/>
                    <TextBlock x:Name="WorkingSetTextBlock" Text="-" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#252526" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="LM Studio" Foreground="#C8C8C8" FontSize="13"/>
                    <TextBlock x:Name="LmStudioStatusTextBlock" Text="-" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#252526" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="GPU Bellek" Foreground="#C8C8C8" FontSize="13"/>
                    <TextBlock x:Name="GpuMemoryTextBlock" Text="-" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="#252526" CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Seçilebilir Tanılama Günlüğü"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="DiagnosticsListBox" Grid.Row="1"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderThickness="0"
                         FontSize="13"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Yenile" Width="100" Margin="0,0,10,0" Click="BtnYenile_Click"
                    Background="#007ACC" Foreground="White" BorderThickness="0"/>
            <Button Content="Seçiliyi Kopyala" Width="140" Margin="0,0,10,0" Click="BtnKopyala_Click"
                    Background="#3A3A3A" Foreground="White" BorderThickness="0"/>
            <Button Content="Kapat" Width="100" Click="BtnKapat_Click"
                    Background="#3A3A3A" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
